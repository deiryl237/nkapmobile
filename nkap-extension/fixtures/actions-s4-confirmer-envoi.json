    {
      "at": 2400,
      "do": [
        { "t": "frame", "id": "f-btn-confirmer", "target": { "match_text": ["Confirmer le transfert", "Confirmer"] }, "label": "Appuie ici" },
        { "t": "speak", "phrase_key": "recap_confirm", "text": "Puis appuie sur Confirmer le transfert pour envoyer l'argent.", "lang": "fr" }
      ]
    },
    {
      "at": 6400,
      "do": [{ "t": "clear" }]
    }
