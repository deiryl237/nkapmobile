{
  "id": "s4-confirmer-envoi",
  "screen": "recap",
  "question_examples": [
    "Tout est bon, comment j'envoie ?",
    "Comment confirmer le transfert ?",
    "Où appuyer pour valider définitivement ?"
  ],
  "steps": [
