{
  "id": "s1-solde",
  "screen": "home",
  "question_examples": [
    "Quel est mon solde ?",
    "Combien il me reste sur mon compte ?",
    "Montre-moi mon argent disponible"
  ],
  "steps": [
    {
      "at": 0,
      "do": [
        { "t": "speak", "phrase_key": "balance_intro", "text": "Je t'explique ton solde.", "lang": "fr" },
        { "t": "underline", "id": "u-solde-label", "target": { "match_text": ["Solde disponible", "Votre solde", "Solde"] }, "color": "yellow", "duration_ms": 450 }
      ]
    },
    {
      "at": 900,
      "do": [
        { "t": "box", "id": "b-solde-montant", "target": { "match_regex": "\\d[\\d\\s.,\\u00A0\\u202F]*\\s*(?:FCFA|francs?)", "pick": "largest_value" }, "color": "ink", "duration_ms": 720 },
        { "t": "speak", "phrase_key": "balance_show", "text": "Ton solde disponible est écrit ici.", "lang": "fr" }
      ]
    },
    {
      "at": 4200,
      "do": [
        { "t": "speak", "phrase_key": "balance_done", "text": "Tu peux maintenant faire un transfert ou consulter les frais.", "lang": "fr" }
      ]
    },
    {
      "at": 7200,
      "do": [{ "t": "clear" }]
    }
  ]
}

