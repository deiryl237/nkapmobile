[Unit]
Description=NKAP M2 FastAPI Cerveau
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/nkap/app/nkapmobile
EnvironmentFile=/opt/nkap/app/nkapmobile/cerveau/.env
ExecStart=/opt/nkap/venv/bin/uvicorn app.main:app --app-dir /opt/nkap/app/nkapmobile/cerveau --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
