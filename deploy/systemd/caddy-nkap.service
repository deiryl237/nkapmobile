[Unit]
Description=Caddy HTTPS reverse proxy for NKAP Cerveau
After=network-online.target nkap-cerveau.service
Wants=network-online.target

[Service]
User=ec2-user
Group=ec2-user
Environment="XDG_DATA_HOME=/opt/nkap/caddy/data"
Environment="XDG_CONFIG_HOME=/opt/nkap/caddy/config"
ExecStart=/opt/nkap/bin/caddy run --environ --config /opt/nkap/caddy/Caddyfile
ExecReload=/opt/nkap/bin/caddy reload --config /opt/nkap/caddy/Caddyfile --force
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
