  "screen_guides": {
    "home": {
      "llm_summary": "Accueil Orange Max it : solde Orange Money (Main Account) et QR code en haut, crédit d'appel (My Credits) au milieu, raccourcis (Buy a bundle, Top Up, Money transfer, Pay your purchases, Cancel transaction).",
      "spoken": "Tu es sur l'accueil d'Orange Max it. En haut tu vois ton solde Orange Money (Main Account) et ton QR code, puis ton crédit d'appel, et en dessous les raccourcis pour envoyer de l'argent, acheter un forfait, recharger ou annuler un transfert.",
      "highlights": [
        {
          "match": [
            "money transfer",
            "envoyer de l'argent"
          ],
          "style": "frame",
          "label": "Envoyer",
          "color": "yellow"
        }
      ]
    },
    "transfer": {
      "llm_summary": "Écran Transfert Orange Money (déjà ouvert) : saisir le numéro du bénéficiaire et le montant avant de valider avec ton code secret.",
      "spoken": "Tu es déjà sur l'écran de transfert Orange Money : indique le numéro du destinataire, le montant à envoyer, puis vérifie bien les informations avant de valider.",
      "highlights": []
    },
    "bundle": {
      "llm_summary": "Écran Forfaits Orange Max it (déjà ouvert) : choix d'un forfait internet, appels ou mixte puis paiement par crédit ou Orange Money.",
      "spoken": "Tu es sur l'écran des forfaits Orange : choisis la catégorie (internet ou appels), sélectionne le forfait voulu, puis confirme le mode de paiement.",
      "highlights": []
    },
    "topup": {
      "llm_summary": "Écran Recharge crédit d'appel Orange Max it (déjà ouvert) : numéro à recharger et montant du crédit.",
      "spoken": "Tu es sur l'écran de recharge de crédit : vérifie le numéro à recharger, choisis le montant souhaité puis valide l'opération.",
      "highlights": []
    },
    "cancel": {
      "llm_summary": "Écran Annulation de transaction Orange Money (déjà ouvert) : sélection de l'opération envoyée par erreur pour demander son annulation.",
      "spoken": "Tu es sur l'écran d'annulation de transaction : choisis le transfert envoyé par erreur puis suis les étapes pour demander le remboursement.",
      "highlights": []
    }
  },
  "qa_shortcuts": [
    {
      "id": "maxit_transfer",
