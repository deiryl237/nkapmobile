# Ollama auto-hébergé (local ou VPS) — 100% open-weight
# Exemple VPS direct : http://IP_OU_DOMAINE_VPS:11434
# Exemple tunnel SSH (recommandé) : http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=30
# Optionnel : si ton reverse proxy Nginx/Caddy protège l'accès VPS par Bearer token
# OLLAMA_BEARER_TOKEN=

